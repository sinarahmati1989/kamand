/* ═══════════════════════════════════════
   AURORA GLASS LIGHT THEME — Base
   ═══════════════════════════════════════ */

* {
    font-family: "Segoe UI", "B Nazanin", sans-serif;
    font-size: 14px;
    color: #1E293B;
}

QMainWindow, QDialog, QWidget {
    background-color: transparent;
}

/* پس‌زمینه اصلی با گرادیانت Aurora */
#AuroraBackground {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0    #E0E7FF,
        stop:0.33 #EDE9FE,
        stop:0.66 #FCE7F3,
        stop:1    #DBEAFE
    );
}

/* کارت شیشه‌ای */
#GlassCard {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 20px;
}

/* Label ها */
QLabel {
    background: transparent;
    color: #1E293B;
}

QLabel#TitleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #6366F1;
}

QLabel#SubtitleLabel {
    font-size: 14px;
    color: #64748B;
}