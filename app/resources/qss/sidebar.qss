/* ═══════════════════════════════════════════════
   SIDEBAR — Aurora Glass Light Professional v2
   طراحی حرفه‌ای ERP-گونه
   ═══════════════════════════════════════════════ */


/* ─── کانتینر اصلی سایدبار ─── */
#sidebar {
    background-color: #FFFFFF;
    border-left: 1px solid #E2E8F0;
}


/* ═══════════════════════════════════════════════
   BRAND SECTION — لوگو بالای سایدبار
   ═══════════════════════════════════════════════ */

#sidebarBrand {
    background-color: #FFFFFF;
    border-bottom: 1px solid #F1F5F9;
}

#sidebarLogoTitle {
    color: #0F172A;
    background: transparent;
    font-weight: 800;
    letter-spacing: 0.5px;
}

#sidebarLogoSub {
    color: #94A3B8;
    background: transparent;
    font-weight: 500;
}


/* ═══════════════════════════════════════════════
   SCROLL AREA
   ═══════════════════════════════════════════════ */

#sidebarScroll,
#sidebarMenu {
    background: transparent;
    border: none;
}


/* ═══════════════════════════════════════════════
   SECTION LABEL — هدر بخش (مثل "منوی اصلی")
   ═══════════════════════════════════════════════ */

#sidebarSectionLabel {
    color: #94A3B8;
    background: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 4px 12px;
}


/* ═══════════════════════════════════════════════
   SECTION HEADER — دکمه بازشوی بخش
   ═══════════════════════════════════════════════ */

#sidebarSectionHeader {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 10px;
    text-align: right;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    min-height: 44px;
}

#sidebarSectionHeader:hover {
    background-color: #F1F5F9;
    color: #1E293B;
}

/* هدر بخش وقتی باز است */
#sidebarSectionHeaderActive {
    background-color: #EEF2FF;
    color: #4F46E5;
    border: none;
    border-radius: 10px;
    text-align: right;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 700;
    min-height: 44px;
}

#sidebarSectionHeaderActive:hover {
    background-color: #E0E7FF;
}


/* ═══════════════════════════════════════════════
   SECTION ITEMS CONTAINER — کانتینر آیتم‌های داخلی
   ═══════════════════════════════════════════════ */

#sidebarSectionItems {
    background: transparent;
    border-right: 2px solid #EEF2FF;
    margin-right: 16px;
    padding: 4px 0;
}


/* ═══════════════════════════════════════════════
   SIDEBAR ITEM — آیتم منو (کاربر، مشتری، ...)
   ═══════════════════════════════════════════════ */

#sidebarItem {
    background-color: transparent;
    color: #64748B;
    border: none;
    border-radius: 8px;
    text-align: right;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
    min-height: 38px;
}

#sidebarItem:hover {
    background-color: #F1F5F9;
    color: #334155;
}

/* آیتم فعال — گرادیان زیبا */
#sidebarItemActive {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366F1, stop:1 #8B5CF6
    );
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    text-align: right;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 700;
    min-height: 38px;
}

#sidebarItemActive:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4F46E5, stop:1 #7C3AED
    );
}


/* ═══════════════════════════════════════════════
   USER CARD — کارت کاربر پایین سایدبار
   ═══════════════════════════════════════════════ */

#sidebarUserCard {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

#sidebarUserName {
    color: #0F172A;
    background: transparent;
    font-size: 13px;
    font-weight: 700;
}

#sidebarUserRole {
    color: #64748B;
    background: transparent;
    font-size: 11px;
    font-weight: 500;
}


/* ═══════════════════════════════════════════════
   LOGOUT BUTTON — دکمه خروج
   ═══════════════════════════════════════════════ */

#sidebarLogoutWrap {
    background: transparent;
    border-top: 1px solid #F1F5F9;
}

#sidebarLogout {
    background-color: transparent;
    color: #DC2626;
    border: 1.5px solid #FEE2E2;
    border-radius: 10px;
    text-align: right;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    min-height: 42px;
}

#sidebarLogout:hover {
    background-color: #FEF2F2;
    border-color: #FCA5A5;
    color: #B91C1C;
}


/* ═══════════════════════════════════════════════
   VERSION LABEL — نسخه پایین سایدبار
   ═══════════════════════════════════════════════ */

#sidebarVersion {
    color: #CBD5E1;
    background: transparent;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
}