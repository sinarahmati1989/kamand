/* ────────────────────────────────────────────────
   INPUTS — Aurora
   ──────────────────────────────────────────────── */

/* ═══════════════════════════════════════════════
   Base Inputs
   ═══════════════════════════════════════════════ */

QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: rgba(255, 255, 255, 0.8);
    border: 2px solid #E2E8F0;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    color: #1E293B;
    min-height: 24px;
    selection-background-color: #6366F1;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border-color: #6366F1;
    background-color: rgba(255, 255, 255, 0.95);
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QLineEdit:hover, QTextEdit:hover, QComboBox:hover,
QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover {
    border-color: #C7D2FE;
}


/* ═══════════════════════════════════════════════
   ComboBox — دکمه دراپ‌داون
   ═══════════════════════════════════════════════ */

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center left;
    width: 24px;
    border: none;
    background: transparent;
    margin-left: 4px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6366F1;
    width: 0;
    height: 0;
}

QComboBox::down-arrow:on {
    border-top: none;
    border-bottom: 6px solid #6366F1;
}


/* ═══════════════════════════════════════════════
   ComboBox — لیست کشویی (Popup)
   ═══════════════════════════════════════════════ */

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1.5px solid #6366F1;
    border-radius: 10px;
    padding: 6px;
    outline: 0;
    selection-background-color: #6366F1;
    selection-color: #FFFFFF;
    color: #1E293B;
    font-size: 14px;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: #1E293B;
    padding: 8px 12px;
    border-radius: 6px;
    min-height: 26px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #EEF2FF;
    color: #4F46E5;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #6366F1;
    color: #FFFFFF;
}


/* ═══════════════════════════════════════════════
   QDateEdit — دکمه دراپ‌داون تقویم
   ═══════════════════════════════════════════════ */

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center left;
    width: 24px;
    border: none;
    background: transparent;
    margin-left: 4px;
}

QDateEdit::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6366F1;
    width: 0;
    height: 0;
}


/* ═══════════════════════════════════════════════
   QCalendarWidget — تقویم کامل
   ═══════════════════════════════════════════════ */

QCalendarWidget {
    background-color: #FFFFFF;
    border: 1.5px solid #6366F1;
    border-radius: 12px;
    font-size: 13px;
    min-width: 320px;
    max-width: 360px;
}

/* نوار بالای تقویم (سال/ماه) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #6366F1;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-height: 40px;
    max-height: 40px;
}

/* دکمه‌های < > */
QCalendarWidget QToolButton {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 14px;
    font-weight: 600;
    min-width: 28px;
    min-height: 28px;
    margin: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

QCalendarWidget QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.3);
}

/* دکمه‌های ماه/سال (باز شدن منو) */
QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* منوی انتخاب ماه */
QCalendarWidget QMenu {
    background-color: #FFFFFF;
    border: 1.5px solid #6366F1;
    border-radius: 8px;
    padding: 4px;
    color: #1E293B;
}

QCalendarWidget QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #6366F1;
    color: #FFFFFF;
}

/* SpinBox سال بالای تقویم */
QCalendarWidget QSpinBox {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    color: #1E293B;
    padding: 2px 6px;
    font-size: 13px;
    font-weight: 600;
    min-width: 70px;
    min-height: 24px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

/* جدول روزها */
QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #1E293B;
    selection-background-color: #6366F1;
    selection-color: #FFFFFF;
    outline: 0;
    padding: 4px;
    font-size: 13px;
}

/* روزهای هفته (Sat, Sun, ...) */
QCalendarWidget QAbstractItemView:enabled {
    color: #1E293B;
}

/* روزهای ماه قبل/بعد */
QCalendarWidget QAbstractItemView:disabled {
    color: #CBD5E1;
}

/* هدر روزهای هفته */
QCalendarWidget QTableView QHeaderView::section {
    background-color: #F1F5F9;
    color: #4F46E5;
    font-weight: 700;
    border: none;
    padding: 6px;
    font-size: 12px;
}