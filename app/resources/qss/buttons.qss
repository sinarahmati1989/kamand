/* ═══════════════════════════════════════
   BUTTONS — Aurora
   ═══════════════════════════════════════ */

QPushButton {
    background-color: rgba(99, 102, 241, 0.1);
    color: #6366F1;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(99, 102, 241, 0.2);
    border-color: #6366F1;
}

QPushButton:pressed {
    background-color: rgba(99, 102, 241, 0.3);
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}